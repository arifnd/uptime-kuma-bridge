# --- Uptime Kuma connection ---
UK_BASE_URL=http://localhost:3001
# Provide UK_JWT_TOKEN, or both UK_USERNAME and UK_PASSWORD.
UK_USERNAME=
UK_PASSWORD=
UK_JWT_TOKEN=
# One-time 2FA token, only needed for non-interactive logins with 2FA enabled.
UK_2FA_TOKEN=
# Optional path to persist a remember-me JWT between restarts (mode 0600).
UK_TOKEN_FILE=
UK_CONNECT_TIMEOUT=10
UK_RECONNECT_DELAY_MAX=30
UK_VERIFY_TLS=true
UK_SOCKETIO_PATH=socket.io

# --- Bridge API ---
# Comma-separated. Each entry: "key" (read+write) or "key:r" / "key:rw".
BRIDGE_API_KEYS=
# Comma-separated list of allowed CORS origins (empty = CORS disabled).
BRIDGE_CORS_ORIGINS=
# Serve without inbound auth when no API keys are configured. Only for local/dev.
BRIDGE_ALLOW_ANONYMOUS=true
BRIDGE_STALE_AFTER=30
BRIDGE_HEARTBEAT_BUFFER=100

# --- Misc ---
LOG_LEVEL=INFO
